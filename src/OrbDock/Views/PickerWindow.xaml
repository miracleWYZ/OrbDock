<Window x:Class="OrbDock.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加程序（可多选）" Width="600" Height="660" WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索 + 浏览 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Padding="8,6" FontSize="13" VerticalContentAlignment="Center" />
            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览 exe…" Margin="8,0,0,0" Padding="12,6" />
        </Grid>

        <!-- 多选工具条 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSelectAll" Content="全选" Padding="10,4" Margin="0,0,6,0" />
            <Button x:Name="BtnSelectNone" Grid.Column="1" Content="清除选择" Padding="10,4" Margin="0,0,6,0" />
            <Button x:Name="BtnInvert" Grid.Column="2" Content="反选" Padding="10,4" Margin="0,0,6,0" />
            <TextBlock x:Name="TxCount" Grid.Column="4" VerticalAlignment="Center"
                       Foreground="#5D5D5D" FontSize="12" Text="" />
        </Grid>

        <ListBox x:Name="LstCatalog" Grid.Row="2" SelectionMode="Extended"
                 BorderBrush="#D0D0D0" Background="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,3" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center" Margin="2,0,10,0" Focusable="False"
                                  IsChecked="{Binding IsSelected,
                                              RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                              Mode=TwoWay}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Folder}" Foreground="#8A8A8A" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}" Foreground="#0078D4" FontSize="11"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="取消" Width="88" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="BtnOk" Content="添加" Width="120" Padding="12,6"
                    Background="#0078D4" Foreground="White" BorderBrush="#0078D4" />
        </StackPanel>
    </Grid>
</Window>

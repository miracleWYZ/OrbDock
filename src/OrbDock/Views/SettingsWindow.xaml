<Window x:Class="OrbDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbDock 设置" Width="1000" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Win10 风格强调色（代码里会被系统主题色覆盖） -->
        <Color x:Key="AccentColor">#FF0078D4</Color>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF5D5D5D" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFE5E5E5" />
        <SolidColorBrush x:Key="NavBg" Color="#FFF3F3F3" />

        <!-- 区块标题 -->
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>
        <Style x:Key="SecFirst" TargetType="TextBlock" BasedOn="{StaticResource Sec}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- 左侧导航项 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="44" Margin="4,1">
                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" />
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Background="{DynamicResource Accent}"
                                    Opacity="0" />
                            <ContentPresenter Margin="18,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE9E9E9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE1E1E1" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win10 开关式 CheckBox：文字在左，开关在右 -->
        <Style TargetType="CheckBox">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="38" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="20"
                                    CornerRadius="10" Background="#FF9A9A9A" BorderThickness="0">
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#FFFFFFFF"
                                         HorizontalAlignment="Left" Margin="4,0,0,0" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                                <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win10 滑块：细轨道 + 左侧强调色填充 + 圆形滑块 -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#FFB0B0B0" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="20" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#FFFFFFFF" Stroke="#FF8A8A8A" StrokeThickness="1.5" />
                                                    <Ellipse x:Name="Dot" Fill="{DynamicResource Accent}" Width="0" Height="0" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Width" Value="8" />
                                                        <Setter TargetName="Dot" Property="Height" Value="8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win10 按钮 -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Background="#FFE9E9E9"
                                BorderBrush="#FFBFBFBF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFDDDDDD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFCFCFCF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Background="{DynamicResource Accent}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FF8A8A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#FFD0D0D0" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Grid Grid.Row="0" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="26,18,0,16">
                <Grid Width="28" Height="28" VerticalAlignment="Center">
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF8CC8FF" Offset="0" />
                                <GradientStop Color="#FF1443AA" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="13" Height="8" Fill="#B3FFFFFF" VerticalAlignment="Top" Margin="0,5,0,0" />
                </Grid>
                <TextBlock Text="OrbDock 设置" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                <Button x:Name="BtnReset" Content="恢复默认外观" />
                <Button x:Name="BtnClose" Content="完成" Style="{StaticResource PrimaryButton}" Margin="0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="266" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{StaticResource NavBg}">
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="8,8,8,8"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="位置" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="大小" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="内容" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="颜色" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="外观" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="通用" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- 右侧内容 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="34,20,34,30">
                <Grid>
                    <!-- ══════════ 位置 ══════════ -->
                    <StackPanel x:Name="PagePosition">
                        <TextBlock Text="停靠位置" Style="{StaticResource SecFirst}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="屏幕边缘" Style="{StaticResource Lbl}" />
                            <ComboBox x:Name="CmbEdge" Grid.Column="1" Width="240" HorizontalAlignment="Left">
                                <ComboBoxItem Content="底部（推荐）" Tag="Bottom" />
                                <ComboBoxItem Content="顶部" Tag="Top" />
                                <ComboBoxItem Content="左侧（竖排）" Tag="Left" />
                                <ComboBoxItem Content="右侧（竖排）" Tag="Right" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="显示器" Style="{StaticResource Lbl}" />
                            <ComboBox x:Name="CmbMonitor" Grid.Column="1" Width="240" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="沿边对齐" Style="{StaticResource Lbl}" />
                            <ComboBox x:Name="CmbAlign" Grid.Column="1" Width="240" HorizontalAlignment="Left">
                                <ComboBoxItem Content="居中" Tag="Center" />
                                <ComboBoxItem Content="靠起始端" Tag="Start" />
                                <ComboBoxItem Content="靠末端" Tag="End" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="间距与偏移" Style="{StaticResource Sec}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="沿边偏移" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlOffset" Grid.Column="1" Minimum="-900" Maximum="900" TickFrequency="1" />
                            <TextBlock x:Name="TxOffset" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="距任务栏距离" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlMargin" Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1" />
                            <TextBlock x:Name="TxMargin" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>

                        <TextBlock Text="自动隐藏" Style="{StaticResource Sec}" />
                        <CheckBox x:Name="ChkAutoHide" Content="鼠标离开后自动收入屏幕外" />
                        <Grid Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="隐藏延迟" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlHideDelay" Grid.Column="1" Minimum="0" Maximum="2000" TickFrequency="50" />
                            <TextBlock x:Name="TxHideDelay" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="隐藏后露出" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlReveal" Grid.Column="1" Minimum="0" Maximum="16" TickFrequency="1" />
                            <TextBlock x:Name="TxReveal" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="把鼠标移到屏幕对应边缘即可唤出 Dock（收起后整窗鼠标穿透，不会挡住任何应用）。隐藏后露出 0 像素时，边缘仍有一条不可见的感应带。" />
                    </StackPanel>

                    <!-- ══════════ 大小 ══════════ -->
                    <StackPanel x:Name="PageSize" Visibility="Collapsed">
                        <TextBlock Text="图标" Style="{StaticResource SecFirst}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图标大小" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlIconSize" Grid.Column="1" Minimum="20" Maximum="120" TickFrequency="1" />
                            <TextBlock x:Name="TxIconSize" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图标间距" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlIconGap" Grid.Column="1" Minimum="0" Maximum="40" TickFrequency="1" />
                            <TextBlock x:Name="TxIconGap" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内边距" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlPadding" Grid.Column="1" Minimum="0" Maximum="40" TickFrequency="1" />
                            <TextBlock x:Name="TxPadding" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="圆角半径" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlCorner" Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1" />
                            <TextBlock x:Name="TxCorner" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="圆角半径 0 = 两头完全半圆的胶囊形。" />

                        <TextBlock Text="显示与滚动" Style="{StaticResource Sec}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最多同时显示" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlMaxVisible" Grid.Column="1" Minimum="2" Maximum="30" TickFrequency="1" />
                            <TextBlock x:Name="TxMaxVisible" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="图标超过该数量时，在 Dock 上滚动鼠标滚轮即可左右滚动查看更多。" />

                        <TextBlock Text="鼠标悬停" Style="{StaticResource Sec}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="放大倍率" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlHoverScale" Grid.Column="1" Minimum="1" Maximum="1.6" TickFrequency="0.02" />
                            <TextBlock x:Name="TxHoverScale" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <CheckBox x:Name="ChkNeighbor" Content="相邻图标联动放大（macOS 波浪效果）" />
                    </StackPanel>

                    <!-- ══════════ 内容 ══════════ -->
                    <Grid x:Name="PageContent" Visibility="Collapsed" Height="520">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <!-- 2×2 网格：4 个按钮平分 300px 宽，避免最后一个被挤出边界裁掉 -->
                            <UniformGrid DockPanel.Dock="Top" Columns="2" Rows="2" Margin="0,0,0,6">
                                <Button x:Name="BtnAddApp" Content="添加程序" Margin="0,0,4,4" />
                                <Button x:Name="BtnAddFile" Content="文件…" Margin="4,0,0,4" />
                                <Button x:Name="BtnAddFolder" Content="文件夹…" Margin="0,4,4,0" />
                                <Button x:Name="BtnAddUrl" Content="网址" Margin="4,4,0,0" />
                            </UniformGrid>
                            <Button x:Name="BtnImportDesktop" DockPanel.Dock="Top" Content="导入桌面图标（全部加进 Dock）"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                            <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,10,0,0">
                                <Button x:Name="BtnUp" Content="上移" Margin="0,0,4,0" />
                                <Button x:Name="BtnDown" Content="下移" Margin="4,0,4,0" />
                                <Button x:Name="BtnDel" Content="删除" Margin="4,0,0,0" />
                            </UniformGrid>
                            <ListBox x:Name="LstItems" DisplayMemberPath="Name"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="选中项目设置" Style="{StaticResource SecFirst}" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="名称" Style="{StaticResource Lbl}" />
                                    <TextBox x:Name="TxtName" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="目标" Style="{StaticResource Lbl}" />
                                    <TextBox x:Name="TxtTarget" Grid.Column="1" />
                                    <Button x:Name="BtnBrowseTarget" Grid.Column="2" Content="浏览…" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动参数" Style="{StaticResource Lbl}" />
                                    <TextBox x:Name="TxtArgs" Grid.Column="1" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="自定义图标" Style="{StaticResource Lbl}" />
                                    <TextBox x:Name="TxtIcon" Grid.Column="1" />
                                    <Button x:Name="BtnBrowseIcon" Grid.Column="2" Content="浏览…" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="类型" Style="{StaticResource Lbl}" />
                                    <ComboBox x:Name="CmbKind" Grid.Column="1" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="启动程序 / 打开文件" Tag="Launch" />
                                        <ComboBoxItem Content="网址" Tag="Url" />
                                        <ComboBoxItem Content="文件夹" Tag="Folder" />
                                        <ComboBoxItem Content="命令行" Tag="Command" />
                                        <ComboBoxItem Content="分隔线" Tag="Separator" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="ChkAdmin" Content="以管理员身份运行" />
                                <CheckBox x:Name="ChkEnabled" Content="在 Dock 中显示" />
                                <Button x:Name="BtnApplyItem" Content="应用修改" Margin="0,12,0,0" HorizontalAlignment="Left" />

                                <TextBlock Text="Dock 显示选项" Style="{StaticResource Sec}" />
                                <CheckBox x:Name="ChkShowLabels" Content="鼠标悬停时显示图标名称" />
                                <CheckBox x:Name="ChkShowDot" Content="显示运行中的程序指示点" />
                                <CheckBox x:Name="ChkActivateRunning" Content="点击已运行的程序时切到它的窗口" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="不勾选则每次都重新启动一个（浏览器等需要多开的程序可以不勾）。" />
                                <CheckBox x:Name="ChkShowSettingsBtn" Content="在 Dock 末尾显示设置按钮" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ══════════ 颜色 ══════════ -->
                    <StackPanel x:Name="PageColor" Visibility="Collapsed">
                        <TextBlock Text="主题色" Style="{StaticResource SecFirst}" />
                        <CheckBox x:Name="ChkFollowAccent" Content="跟随 Windows 系统主题色" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                            <TextBlock Text="自定义主色" Style="{StaticResource Lbl}" Width="150" />
                            <Border x:Name="AccentSwatch" Width="46" Height="28" CornerRadius="3"
                                    BorderBrush="#FF8A8A8A" BorderThickness="1" Background="#3D7EFF" />
                            <Button x:Name="BtnAccent" Content="选择颜色…" Margin="10,0,0,0" />
                            <TextBox x:Name="TxtAccentHex" Width="110" Margin="8,0,0,0" />
                            <Button x:Name="BtnAccentPick" Content="同步系统主题色" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="明暗模式" Style="{StaticResource Sec}" />
                        <CheckBox x:Name="ChkFollowTheme" Content="跟随系统浅色 / 深色模式" />
                        <Grid Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模式" Style="{StaticResource Lbl}" />
                            <ComboBox x:Name="CmbThemeMode" Grid.Column="1" Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="跟随系统" Tag="auto" />
                                <ComboBoxItem Content="浅色" Tag="light" />
                                <ComboBoxItem Content="深色" Tag="dark" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="配色强度" Style="{StaticResource Sec}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主题色浓度" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlAccentStrength" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.01" />
                            <TextBlock x:Name="TxAccentStrength" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景色调" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlTintStrength" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.01" />
                            <TextBlock x:Name="TxTintStrength" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>

                        <TextBlock Text="图标名称标签" Style="{StaticResource Sec}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文字颜色" Style="{StaticResource Lbl}" />
                            <TextBox x:Name="TxtLabelFg" Grid.Column="1" />
                            <Button x:Name="BtnLabelFg" Grid.Column="2" Content="选择…" Margin="8,0,0,0" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="标签底色" Style="{StaticResource Lbl}" />
                            <TextBox x:Name="TxtLabelBg" Grid.Column="1" />
                            <Button x:Name="BtnLabelBg" Grid.Column="2" Content="选择…" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="留空表示自动跟随明暗模式。" />
                    </StackPanel>

                    <!-- ══════════ 外观 ══════════ -->
                    <StackPanel x:Name="PageLook" Visibility="Collapsed">
                        <TextBlock Text="玻璃质感" Style="{StaticResource SecFirst}" />
                        <CheckBox x:Name="ChkRealBlur" Content="启用真实的桌面磨砂（毛玻璃）" />
                        <Grid Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模糊强度" Style="{StaticResource Lbl}" />
                            <ComboBox x:Name="CmbBlurMode" Grid.Column="1" Width="280" HorizontalAlignment="Left">
                                <ComboBoxItem Content="标准（推荐）" Tag="0" />
                                <ComboBoxItem Content="更强（更朦胧）" Tag="1" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="不透明度" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlOpacity" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.01" />
                            <TextBlock x:Name="TxOpacity" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="高光强度" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlHighlight" Grid.Column="1" Minimum="0" Maximum="2" TickFrequency="0.02" />
                            <TextBlock x:Name="TxHighlight" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="磨砂颗粒" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlNoise" Grid.Column="1" Minimum="0" Maximum="0.3" TickFrequency="0.005" />
                            <TextBlock x:Name="TxNoise" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <CheckBox x:Name="ChkShadow" Content="显示投影" />
                        <CheckBox x:Name="ChkInnerGlow" Content="显示内部流光（液态流动高光）" />

                        <TextBlock Text="自定义背景板图片" Style="{StaticResource Sec}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnBgImage" Content="选择图片…" Margin="0,0,6,0" />
                            <Button x:Name="BtnClearBgImage" Grid.Column="1" Content="清除" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxBgImage" Grid.Column="2" Style="{StaticResource Lbl}" VerticalAlignment="Center"
                                       Foreground="#FF5D5D5D" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="填充方式" Style="{StaticResource Lbl}" />
                            <ComboBox x:Name="CmbImageStretch" Grid.Column="1" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="等比铺满（裁剪）" Tag="UniformToFill" />
                                <ComboBoxItem Content="等比适应" Tag="Uniform" />
                                <ComboBoxItem Content="拉伸填满" Tag="Fill" />
                                <ComboBoxItem Content="平铺" Tag="None" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图片不透明度" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlImageOpacity" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.01" />
                            <TextBlock x:Name="TxImageOpacity" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="图片模糊" Style="{StaticResource Lbl}" />
                            <Slider x:Name="SlImageBlur" Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1" />
                            <TextBlock x:Name="TxImageBlur" Grid.Column="2" Style="{StaticResource Val}" />
                        </Grid>
                    </StackPanel>

                    <!-- ══════════ 通用 ══════════ -->
                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                        <TextBlock Text="应急关闭快捷键" Style="{StaticResource SecFirst}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全局热键" Style="{StaticResource Lbl}" />
                            <TextBox x:Name="TxtHotkey" Grid.Column="1" IsReadOnly="True" Width="220"
                                     HorizontalAlignment="Left" Background="#FFF2F2F2" />
                            <Button x:Name="BtnRecord" Grid.Column="2" Content="录制按键" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="默认 Ctrl+Alt+F12。该热键通过底层键盘钩子实现，优先级高于任何应用程序，按下后立即结束 OrbDock 进程，并会吞掉按键（其它程序收不到）。" />
                        <TextBlock x:Name="TxHotkeyState" Style="{StaticResource Hint}" Foreground="#FF107C10" Text="" />

                        <TextBlock Text="窗口层级" Style="{StaticResource Sec}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="层级" Style="{StaticResource Lbl}" />
                            <ComboBox x:Name="CmbLayer" Grid.Column="1" Width="300" HorizontalAlignment="Left">
                                <ComboBoxItem Content="桌面层（被窗口压住，不挡任何应用）" Tag="Desktop" />
                                <ComboBoxItem Content="普通窗口（唤出时浮到最前）" Tag="Normal" />
                                <ComboBoxItem Content="始终置顶（永远在最前）" Tag="Topmost" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="桌面层：Dock 始终位于所有应用窗口之下、桌面壁纸之上，因此会被窗口压住、只露出没被挡住的部分；无论哪种层级，收起后整窗鼠标穿透，绝不阻挡点击。" />

                        <TextBlock Text="启动与托盘" Style="{StaticResource Sec}" />
                        <CheckBox x:Name="ChkHideDesktopIcons" Content="隐藏桌面图标（图标已收进 Dock）" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="只是隐藏，文件仍在桌面文件夹里；取消勾选即可恢复（或桌面右键 → 查看 → 显示桌面图标）。" />
                        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动" />
                        <CheckBox x:Name="ChkTray" Content="在系统托盘显示图标（可从这里重新打开设置）" />

                        <TextBlock Text="关于" Style="{StaticResource Sec}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="OrbDock · 液态玻璃桌面导航栏。配置位于 %APPDATA%\OrbDock\settings.json（不可写时自动回退到 %LOCALAPPDATA% 或程序目录 data\），日志为同目录 orblock.log。" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="提示：在 Dock 上按住图标左右拖动可以调整顺序；右键 Dock 可打开菜单；鼠标移到屏幕对应边缘即可唤出。" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
